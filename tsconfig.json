{
	"compilerOptions": {
		"target": "ES2019",
		"module": "CommonJS",
		"lib": ["ES2019"],
		"moduleResolution": "Node",
		"outDir": "dist",
		"rootDir": ".",
		"declaration": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true
	},
	"include": [
		"index.ts",
		"credentials/**/*.ts",
		"helpers/**/*.ts",
		"nodes/**/*.ts"
	]
}
